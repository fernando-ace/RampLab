<?xml version="1.0"?>
<package format="3">
  <name>ramplab_ros2_controller</name>
  <version>0.1.0</version>
  <description>Separate sensor-only ROS 2 route controller for the RampLab tug.</description>
  <maintainer email="ramplab@example.invalid">RampLab</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
